# ─── DB ──────────────────────────────────────────────────────────────────────
# Supabase > Connect > Session pooler 의 URI 를 그대로 붙여넣고 비밀번호만 채우세요.
#
#   반드시 Session pooler(포트 5432) 를 쓰세요.
#     - Direct connection 은 무료 티어에서 IPv6 전용이라 IPv4 환경/GitHub Actions 에서 실패합니다.
#     - Transaction pooler(6543) 는 세션 설정과 트랜잭션 제약이 있어 마이그레이션에 부적합합니다.
#   사용자명이 postgres 가 아니라 postgres.<프로젝트ref> 형태인 것에 주의하세요.
#   비밀번호에 특수문자가 있으면 percent-encoding 이 필요합니다 (@ -> %40, # -> %23).
#   영숫자 비밀번호로 재설정하는 편이 간단합니다.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# DB TLS 검증용 CA 인증서 (선택). 비워두면 시스템 신뢰 저장소로 검증합니다.
# 검증 자체는 항상 켜져 있으며, 이 프로젝트는 검증을 끄는 우회를 제공하지 않습니다.
# 이 값을 주면 해당 CA 만 신뢰하는 인증서 고정(pinning)이 되어 방어가 한 단계 강해집니다.
#   Supabase > Project Settings > Database > 맨 아래 SSL Configuration > Download certificate
#   내려받은 파일을 secrets/ 아래 두세요 (secrets/ 는 .gitignore 됨).
# 어느 쪽이 필요한지는 `npm run db:check` 가 알려줍니다.
DATABASE_CA_CERT_PATH=
# CI 등 파일을 둘 수 없는 환경에서는 PEM 본문을 직접 넣습니다.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# 로컬 평문 Postgres 를 쓸 때만. localhost 연결에서만 동작하고 원격이면 예외가 납니다.
# DATABASE_SSL=disable

# ─── 외부 API 키 (모두 서버 사이드 전용) ─────────────────────────────────────
# 고용24(워크넷) 오픈API  https://openapi.work.go.kr
#
#   주의: 이 사이트는 API 마다 인증키를 따로 발급한다. 계정 키 하나로 전부
#   호출할 수 없으므로, 활용신청한 API 별 키를 각 항목에 맞게 넣어야 한다.
#
#   필요한 API 는 두 개다.
#     - 채용정보  : 필수. 수집기의 기반 데이터
#     - 공통코드  : 권장. 직종/지역 코드 마스터 (jobsCd -> 직종명 정규화)
#   훈련과정 계열, 취업역량 강화프로그램, 직업/직무정보는 이 프로젝트에 불필요하다.
WORKNET_API_KEY=
WORKNET_CODE_API_KEY=

# ─── 공공데이터포털 (data.go.kr) ────────────────────────────────────────────
# 국토교통부 전월세 실거래가 4종에 쓰는 인증키. 이 프로젝트의 주 데이터 소스입니다.
#   이용허락범위 제한 없음(상업적 이용 가능), 자동승인, 개발계정 10,000회/일
#
#   신청할 데이터셋 4종 (모두 자동승인). ID 가 연속이므로 링크로 바로 들어가면 됩니다:
#     15126472  국토교통부_단독/다가구 전월세 실거래가 자료
#     15126473  국토교통부_연립다세대 전월세 실거래가 자료
#     15126474  국토교통부_아파트 전월세 실거래가 자료
#     15126475  국토교통부_오피스텔 전월세 실거래가 자료
#   https://www.data.go.kr/data/<ID>/openapi.do
#
#   단독/다가구는 개인정보 보호로 지번정보 일부만 제공됩니다. 상당수가 건물 단위
#   좌표를 얻지 못해 법정동 중심점으로 폴백되고 commute_usable=false 로 격리됩니다.
#
#   공공데이터포털은 계정당 인증키 1개를 모든 API 에 공용으로 씁니다(고용24와 반대).
#   마이페이지 > 오픈API > 인증키 발급현황 의 **일반 인증키(Decoding)** 를 넣으세요.
#   Encoding 키를 넣으면 이중 인코딩되어 인증이 실패합니다.
MOLIT_API_KEY=

# Kakao Developers > REST API 키. 절대 프론트엔드로 내보내지 마세요.
# 프론트에 필요한 것은 도메인 제한이 걸린 JavaScript 키뿐이며, 주소 검색은
# Next.js API Route 를 프록시로 두고 서버에서만 REST 키를 사용합니다.
KAKAO_REST_KEY=

# ─── 자체 호스팅 라우팅 엔진 ─────────────────────────────────────────────────
# Valhalla / OTP2 에는 인증 기능이 없습니다. 반드시 인증 프록시(docker/) 뒤에 두고,
# 프록시 주소를 여기에 넣으세요. 엔진 포트를 직접 노출하면 누구나 당신 PC 를 두들깁니다.
ROUTING_URL=http://localhost:8000
# openssl rand -hex 32  으로 생성. 프록시와 동일한 값을 사용합니다.
ROUTING_TOKEN=

# ─── 수집기 튜닝 ─────────────────────────────────────────────────────────────
COLLECT_MAX_PAGES=0        # 0 = 무제한. 첫 실행은 2 로 두고 필드 매핑을 확인하세요.
GEOCODE_DAILY_LIMIT=50000
