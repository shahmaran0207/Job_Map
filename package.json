{
  "name": "job-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:check": "tsx src/scripts/db-check.ts",
    "keys:check": "tsx src/scripts/check-keys.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "collect": "tsx src/collectors/run.ts",
    "collect:worknet": "tsx src/collectors/run.ts --source=worknet",
    "geocode": "tsx src/scripts/geocode-pending.ts",
    "stats": "tsx src/scripts/stats.ts",
    "test:ingest": "tsx src/scripts/smoke-ingest.ts",
    "test:parse": "tsx src/scripts/smoke-worknet.ts",
    "typecheck": "tsc --noEmit",
    "test:resolver": "tsx src/scripts/smoke-resolver.ts",
    "probe:molit": "tsx src/scripts/probe-molit.ts",
    "probe:work24": "tsx src/scripts/probe-work24.ts",
    "seed:regions": "tsx src/scripts/seed-regions.ts",
    "collect:rent": "tsx src/collectors/molit-run.ts",
    "test:molit": "tsx src/scripts/smoke-molit-parse.ts",
    "stats:rent": "tsx src/scripts/stats-rent.ts",
    "geocode:buildings": "tsx src/scripts/geocode-buildings.ts",
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next dev -p 3000 -H 127.0.0.1",
    "start:prod": "next start -p 3000 -H 127.0.0.1",
    "inspect:geocode": "tsx src/scripts/inspect-geocode.ts",
    "routing:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "routing:up:transit": "docker compose --env-file .env -f docker/docker-compose.yml --profile transit up -d",
    "routing:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "routing:logs": "docker compose --env-file .env -f docker/docker-compose.yml logs -f --tail=50",
    "routing:check": "tsx src/scripts/check-routing.ts",
    "routing:ps": "docker compose --env-file .env -f docker/docker-compose.yml ps"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.0",
    "maplibre-gl": "^6.6.0",
    "next": "^15.5.24",
    "pg": "^8.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.26"
  }
}
